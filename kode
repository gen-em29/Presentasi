    </main>
    
    <footer class="bg-white mt-12">
        <div class="container mx-auto py-4 px-4 sm:px-6 lg:px-8 text-center text-gray-500 text-sm">
            <p>&copy; 2025 Gen Yus Hafiz Moreno - Laporan Interaktif PKL Poltekkes Kemenkes Surabaya di RS Mata Cicendo.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const navLinks = document.querySelectorAll('.nav-link');
            const contentSections = document.querySelectorAll('.content-section');
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');

            function switchTab(targetId) {
                contentSections.forEach(section => {
                    section.classList.remove('active');
                });
                document.getElementById(targetId).classList.add('active');

                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.dataset.target === targetId) {
                        link.classList.add('active');
                    }
                });
            }

            navLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.dataset.target;
                    switchTab(targetId);
                    if(mobileMenu.classList.contains('block')){
                        mobileMenu.classList.remove('block');
                        mobileMenu.classList.add('hidden');
                    }
                });
            });

            mobileMenuButton.addEventListener('click', function() {
                const isHidden = mobileMenu.classList.contains('hidden');
                if (isHidden) {
                    mobileMenu.classList.remove('hidden');
                    mobileMenu.classList.add('block');
                } else {
                    mobileMenu.classList.remove('block');
                    mobileMenu.classList.add('hidden');
                }
            });
            
            const timelineTitles = document.querySelectorAll('.timeline-title');
            timelineTitles.forEach(title => {
                title.addEventListener('click', () => {
                    const content = title.nextElementSibling.nextElementSibling;
                    if (content.style.maxHeight) {
                        content.style.maxHeight = null;
                    } else {
                        content.style.maxHeight = content.scrollHeight + "px";
                    }
                });
            });

            const sectionToggles = document.querySelectorAll('.section-title-toggle');
            sectionToggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const targetId = toggle.dataset.toggle;
                    const content = document.getElementById(targetId);
                    const icon = toggle.querySelector('svg');

                    if (content.style.maxHeight) {
                        content.style.maxHeight = null;
                        toggle.classList.remove('expanded');
                    } else {
                        content.style.maxHeight = content.scrollHeight + "px";
                        toggle.classList.add('expanded');
                    }
                });
            });

            const probeData = {
                labels: ['A-Scan', 'B-Scan (1)', 'B-Scan (2)', 'Pachymeter', 'UBM'],
                frequencies: [10, 12, 15, 10.5, 48],
                resolutions: [0.1, 0.015, 0.015, 0.005, 0.015], // Pachymeter accuracy is 5µm = 0.005mm
                resolutionLabels: ['Akurasi (mm)', 'Resolusi Axial (mm)', 'Resolusi Axial (mm)', 'Akurasi (mm)', 'Resolusi Axial (mm)']
            };

            const freqCtx = document.getElementById('frequencyChart').getContext('2d');
            new Chart(freqCtx, {
                type: 'bar',
                data: {
                    labels: probeData.labels,
                    datasets: [{
                        label: 'Frekuensi (MHz)',
                        data: probeData.frequencies,
                        backgroundColor: 'rgba(0, 122, 122, 0.6)',
                        borderColor: 'rgba(0, 122, 122, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Frekuensi (MHz)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });

            const resCtx = document.getElementById('resolutionChart').getContext('2d');
            new Chart(resCtx, {
                type: 'bar',
                data: {
                    labels: probeData.labels,
                    datasets: [{
                        label: 'Resolusi/Akurasi (mm)',
                        data: probeData.resolutions,
                        backgroundColor: 'rgba(255, 159, 64, 0.6)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            type: 'logarithmic',
                            title: {
                                display: true,
                                text: 'Resolusi/Akurasi (mm) - Skala Log'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                             callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.parsed.y !== null) {
                                        label += context.parsed.y + ' mm';
                                    }
                                    const originalLabel = probeData.resolutionLabels[context.dataIndex];
                                    return [label, '(' + originalLabel + ')'];
                                }
                            }
                        }
                    }
                }
            });

        });
    </script>
</body>
</html>
